# Backend API prefix (proxied by Vite dev server)
VITE_API_BASE_URL=/api/v1

# Vite dev proxy target (FastAPI). Default matches be/main.py uvicorn port 8000.
# Use http://localhost:18080 if your API runs on 18080 (e.g. Docker).
# VITE_DEV_API_PROXY_TARGET=http://localhost:8000

# Optional CDN base URL for rewriting image paths on frontend
# VITE_CDN_BASE_URL=https://your-cdn.example.com
