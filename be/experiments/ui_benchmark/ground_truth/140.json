    {
      "type": "text",
      "label": "The Void (Linux) distribution",
      "text": "The Void (Linux) distribution",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        181.0,
        348.0,
        239.0,
        527.0
      ]
    },
    {
      "type": "text",
      "label": "informational paragraph",
      "text": "Void is a general purpose operating system, based on the monolithic Linux kernel. Its package system allows you to quickly install, update and remove software; software is provided in binary packages or can be built directly from sources with the help of the XBPS source packages collection.",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        269.0,
        348.0,
        422.0,
        859.0
      ]
    },
    {
      "type": "text",
      "label": "informational paragraph",
      "text": "It is available for a variety of platforms. Software packages can be built natively or cross compiled through the XBPS source packages collection.",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        418.0,
        348.0,
        493.0,
        838.0
      ]
    },
    {
      "type": "text",
      "label": "informational paragraph",
      "text": "Follow us on Mastodon, visit the #voidlinux IRC channel on libera.chat, and join the Void Linux subreddit.",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        492.0,
        347.0,
        539.0,
        852.0
      ]
    },
    {
      "type": "text",
      "label": "informational paragraph",
      "text": "Visit the Void build server console for package build status updates.",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        536.0,
        347.0,
        571.0,
        803.0
      ]
    },
    {
      "type": "text",
      "label": "informational paragraph",
      "text": "Contribute to the Void Linux project by adding and updating packages and extending the documentation. More information can be found in the Handbook.",
      "actionable": false,
      "is_feedback": false,
      "bbox": [
        572.0,
        347.0,
        655.0,
        864.0
      ]
    },
