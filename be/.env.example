API_V1_STR=/api/v1
PROJECT_NAME="UI TestGen Backend"
PROJECT_VERSION=1.0.0
PROJECT_DESCRIPTION="API for UI TestGen, providing endpoints to analyze UI screenshots and generate test cases."

# OpenAI
OPENAI_API_KEY=sk-proj-...

# Gemini
GEMINI_API_KEY=AIza...

# Backblaze B2
B2_KEY_ID=
B2_KEY_NAME=
B2_APPLICATION_KEY=
B2_ENDPOINT=
B2_REGION=
B2_BUCKET_NAME=
B2_PRESIGNED_EXPIRES_SECONDS=3600
B2_PRESIGNED_GET_EXPIRES_SECONDS=3600
B2_DEFAULT_INPUTS_PREFIX=default-inputs
B2_USER_INPUTS_PREFIX=user-inputs

# Storage mode: local | b2 | auto
STORAGE_TYPE=b2

# Supabase (only used for analysis records)
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_ANALYSIS_TABLE=user_goals_history

# Data retention (days)
DATA_RETENTION_DAYS=15

# Test scenario generation (optional overrides; defaults match app/core/config.py)
# SINGLE_STAGE_TEST_SCENARIO_PROMPT_PATH=app/llm_prompts/test_scenarios_from_ui_system_prompt.txt
# TWO_STAGE_UI_HIERARCHY_PROMPT_PATH=app/llm_prompts/ui_extraction_system_prompt.txt
# TWO_STAGE_TEST_SCENARIO_PROMPT_PATH=app/llm_prompts/test_scenarios_from_ui_hierarchy_system_prompt.txt
# TWO_STAGE_STAGE1_MODEL=gemini-2.5-flash
# TWO_STAGE_STAGE2_MODEL=gpt-5
