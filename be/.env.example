ENVIRONMENT=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=ui-testgen-local
STORAGE_SECURE=false
DATABASE_URL=postgresql+asyncpg://testgen_user:testgen_password@localhost:5433/testgen_db
REDIS_URL=redis://localhost:6379/0

# Pipeline log streaming (`GET /runs/{id}/pipeline-log`): worker writes under this path relative to backend root.
# The API process must see the same directory as the ARQ worker (same checkout, or identical Docker volume mount).
# PIPELINE_RUN_LOG_ROOT=var/pipeline_run_logs

# Worker / model timeouts — see docs/ENVIRONMENT.md and docs/QUEUE.md
# ARQ_JOB_TIMEOUT_SECONDS=14400
# ARQ_JOB_LONG_PIPELINE_FALLBACK_SECONDS=14400  # target when rewriting 300s
# ARQ_JOB_NO_TIMEOUT=false
# DISABLE_MODEL_CALL_ASYNCIO_TIMEOUT=false
# DISABLE_MODEL_HTTP_TIMEOUT=false
